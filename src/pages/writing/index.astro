---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { writingSeries } from '../../data/home';
import { getPublishedArticles } from '../../lib/articles';
const articles = await getPublishedArticles();
const firstArticle = articles.find(article => article.id === writingSeries.firstArticleId);
const otherArticles = articles.filter(article => article.id !== writingSeries.firstArticleId);
---
<BaseLayout title="Writing — Erika Lee" description="Notes on AI, software, and things I've been curious enough to explore.">
  <div class="wrap writing-index">
    <header><h1>Writing</h1><p>Notes on AI, software, and things I've been curious enough to explore.</p></header>
    <section aria-labelledby="series-title">
      <h2 id="series-title">{writingSeries.title}</h2>
      <p>A three-part introduction to language models, practical AI applications, and agents.</p>
      <p class="status">First article ready to read. Two more in progress.</p>
      <ol>{writingSeries.articles.map((title, i) => <li><h3>{i === 0 && firstArticle ? <a href={`/writing/${firstArticle.id}`}>{firstArticle.data.title}</a> : title}</h3>{i !== 0 && <span class="status">In progress</span>}</li>)}</ol>
    </section>
    {otherArticles.length > 0 && <section aria-labelledby="published-title"><h2 id="published-title">Articles</h2><ul>{otherArticles.map(article => <li><h3><a href={`/writing/${article.id}`}>{article.data.title}</a></h3><p>{article.data.description}</p></li>)}</ul></section>}
  </div>
</BaseLayout>
<style>
.writing-index { padding-block:24px 64px; }
header,section { max-width:70ch; }
h1 { font-size:clamp(3rem,6vw,4.3rem); margin-bottom:20px; }
header p,section > p { color:var(--muted); }
section { margin-top:40px; }
h2 { margin-bottom:16px; font-size:clamp(1.6rem,3vw,2rem); }
.status { font-size:.85rem; color:var(--muted); }
section > .status { margin-top:12px; }
ol,ul { margin:24px 0 0; padding-left:24px; }
li { padding-left:8px; }
li + li { margin-top:22px; }
h3 { font-size:1.2rem; line-height:1.5; }
</style>
