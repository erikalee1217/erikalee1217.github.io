---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import cover from '../../assets/projects/clearstep-cover-en.png';
import { featuredProject, secondaryProjects } from '../../data/home';
---
<BaseLayout title="Work — Erika Lee" description="Selected work in applied AI, language model research, and data engineering.">
  <div class="wrap work-index">
    <header class="page-heading"><h1>Work</h1><p>Projects in applied AI, research, and data engineering.</p></header>
    <article class="featured-project">
      <div><p class="eyebrow">{featuredProject.category}</p><h2>ClearStep</h2><p class="project-description">{featuredProject.description}</p><p class="tools">{featuredProject.tools}</p><a class="text-link case-link" href="/work/clearstep">Read the case study <span aria-hidden="true">→</span></a></div>
      <Image src={cover} alt="Composite promotional cover based on the ClearStep UI, showing its name, tagline, and task interface." widths={[480,800,1200]} sizes="(max-width: 560px) 90vw, 50vw" />
    </article>
    <div class="project-list">{secondaryProjects.map((project,i)=><article class="project"><p class="eyebrow category">{i === 0 ? 'LLM Research' : project.category}</p><h2>{project.title}</h2><p class="project-description">{project.description}</p><p class="tools">{project.tools}</p>{project.href && <a class="text-link" href={project.href}>Code on GitHub</a>}</article>)}</div>
  </div>
</BaseLayout>
<style>
.work-index { padding-block: 24px 64px; }
.page-heading { margin-bottom: 40px; }
h1 { font-size: clamp(3rem,6vw,4.3rem); margin: 8px 0 16px; }
.page-heading > p:last-child { color: var(--muted); }
.featured-project h2 { margin-top: 10px; }
img { display:block; width:100%; height:auto; }
.case-link { margin-top: 20px; }
.project-list { margin-top:40px; }
.project h2 { font-size: clamp(1.3rem,2vw,1.6rem); }
</style>
